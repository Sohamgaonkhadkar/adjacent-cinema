# Copy to .env and fill in. `.env` is gitignored — NEVER commit a real key.
#
# Nothing in this repository requires a key: the test suite, the probe (dry-run)
# and the whole fixture-backed mock run work with QLOO_API_KEY unset.

# Leave blank to stay in mock mode. Set it to go live: the mode is reported as
# "live"/"mock" by /health, the probe and every run, and the key itself is never
# printed, traced, written to docs, or committed.
QLOO_API_KEY=

# Do NOT point a hackathon key at staging or production — both return 401 and
# that is not a symptom of a bad key. Our Python client uses QLOO_BASE_URL; the
# official harness (@qloo/qloo-harness) reads QLOO_TRUSTED_BASE_URL. Same host,
# both names, so one file configures both. See docs/QLOO_SETUP.md.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# Optional client tuning
QLOO_CONNECT_TIMEOUT_S=1.5
QLOO_READ_TIMEOUT_S=8.0
QLOO_MAX_RETRIES=3
QLOO_RATE_LIMIT_RPS=3

# Candidate cities for the coverage probe, separated by SEMICOLONS.
# A comma belongs to the city name ("London, UK"), so it cannot separate entries:
# splitting on commas would silently produce "London", "UK", "New York", "NY", ...
QLOO_PROBE_CITIES=London, UK;New York, NY;Portland, Oregon

# Deliberately not fixed to one city: the demo city is chosen from live evidence
# (see docs/LIVE_QLOO_VALIDATION.md once the probe has run against Qloo).

# --- YouTube Analytics integration (M13.10, optional) ---------------------
# Leave all three blank to keep the integration in the honest
# "not_configured" state. Create an OAuth client (Web application) in the
# Google Cloud Console with the YouTube Data API v3 and YouTube Analytics API
# enabled. The redirect URI below must EXACTLY match a registered URI.
# NEVER commit real values; `.env` is gitignored.
#
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
#
# Opt-in offline demo of the connection flow with clearly-labelled mock data
# (never used as a fallback for failed live calls):
# ADJACENT_YT_MOCK=1
