# Copy this file to .env on the deployment host, then replace the sample domain.
# Keep .env private (chmod 600). Never commit or paste real provider credentials.
DOMAIN=your-domain.example
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# Safe public-demo defaults: fixtures work; public live Creator remains disabled.
ADJACENT_PUBLIC_DEMO=1
ADJACENT_PUBLIC_LIVE=0
ADJACENT_FILMSPONSOR_GUEST_DEMO=1
ADJACENT_FILMSPONSOR_GUEST_ORIGINS=https://your-domain.example
ADJACENT_FILMSPONSOR_GUEST_COOKIE_SECURE=1
