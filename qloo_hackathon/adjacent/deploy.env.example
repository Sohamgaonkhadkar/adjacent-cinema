# Copy this file to .env on the deployment host, then replace the sample domain.
# Keep .env private (chmod 600). Never commit or paste real provider credentials.
DOMAIN=your-domain.example
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# Safe public-demo defaults: fixtures work; public live Creator remains disabled.
ADJACENT_PUBLIC_DEMO=1
ADJACENT_PUBLIC_LIVE=0
ADJACENT_FILMSPONSOR_GUEST_DEMO=1
ADJACENT_FILMSPONSOR_GUEST_ORIGINS=https://your-domain.example
ADJACENT_FILMSPONSOR_GUEST_COOKIE_SECURE=1

# ── Optional provider integrations ─────────────────────────────────────────
# Each of these can stay empty: the feature then reports an honest
# "unavailable"/"blocked" state instead of substituting invented data.
# See docs/CONFIGURATION.md for the full matrix and the live-check runbook.

# Optional LLM decision-brief synthesis (OpenAI-compatible endpoint).
ADJACENT_LLM_API_KEY=
ADJACENT_LLM_BASE_URL=
ADJACENT_LLM_MODEL=

# YouTube Analytics observations (Google Cloud OAuth 2.0 web client).
# YOUTUBE_REDIRECT_URI must match the URI registered on that client exactly.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# Persistent storage for the YouTube refresh token (pair with ADJACENT_EXPERIMENTS_DB).
ADJACENT_YT_TOKEN_DB=/data/youtube_tokens.db

# Test/demo only: serves clearly labelled mock analytics. Never enable on a
# deployment that claims live numbers.
# ADJACENT_YT_MOCK=1
